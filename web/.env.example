# Credenciales de LiveKit Cloud (obligatorias en Vercel y en .env.local)
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Clave(s) de Groq para mostrar el indicador de tokens/cuota gratuita en la interfaz web
GROQ_API_KEY=
# GROQ_API_KEYS=gsk_clave1,gsk_clave2,gsk_clave3

# Opcional: si lo defines, la API exigirá este código para emitir tokens y evitar que terceros consuman tus minutos
# APP_ACCESS_CODE=
